#!/bin/sh
set -eu

# Keep Hermes state in the sandbox rather than in the image or the host.
export HERMES_HOME="${HERMES_HOME:-/sandbox/.hermes}"
export HOME="${HOME:-/sandbox}"
unset CUSTOM_BASE_URL OPENAI_BASE_URL OPENROUTER_BASE_URL
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

mkdir -p "$HERMES_HOME"
config="$HERMES_HOME/config.yaml"
if [ ! -f "$config" ]; then
  cp /usr/share/hermes/config.yaml "$config"
fi

# Reused sandboxes can retain a config from an older image. The provider and
# endpoint are image-owned for this seat; keep an operator-selected model unless
# it is the old inference-router placeholder.
/opt/hermes/.venv/bin/python - "$config" <<'PY'
import sys
from pathlib import Path

import yaml

config_path = Path(sys.argv[1])
config = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
if not isinstance(config, dict):
    config = {}
model = config.get("model")
if not isinstance(model, dict):
    model = {}
model["provider"] = "openrouter"
model["base_url"] = "https://openrouter.ai/api/v1"
if str(model.get("default") or "").strip() in {"", "router"}:
    model["default"] = "openai/gpt-4o-mini"
config["model"] = model
config_path.write_text(
    yaml.safe_dump(config, default_flow_style=False, sort_keys=False),
    encoding="utf-8",
)
PY

# Board MCP injection is a fragment so a reused cockpit sandbox can retain its
# Hermes state while sandboard remains authoritative for attached servers.
fragment=/sandbox/.sandboard/mcp/hermes_mcp.yaml
if [ -f "$fragment" ]; then
  /opt/hermes/.venv/bin/python - "$config" "$fragment" <<'PY'
import os
import re
import sys
from pathlib import Path

import yaml

config_path = Path(sys.argv[1])
fragment_path = Path(sys.argv[2])

def expand(value):
    if isinstance(value, dict):
        return {key: expand(item) for key, item in value.items()}
    if isinstance(value, list):
        return [expand(item) for item in value]
    if isinstance(value, str):
        return re.sub(
            r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}",
            lambda match: os.environ.get(match.group(1), match.group(0)),
            value,
        )
    return value

config = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
fragment = yaml.safe_load(fragment_path.read_text(encoding="utf-8")) or {}
if not isinstance(config, dict):
    config = {}
servers = fragment.get("mcp_servers", {})
config["mcp_servers"] = expand(servers if isinstance(servers, dict) else {})
config_path.write_text(
    yaml.safe_dump(config, default_flow_style=False, sort_keys=False),
    encoding="utf-8",
)
PY
fi

exec /opt/hermes/.venv/bin/hermes "$@"
