# Microshift/OCP operator sandbox: cursor base + stock oc/kubectl on PATH.
#
# No PATH wrappers. Clients are the upstream binaries. Auth and server URL
# are normal kube concerns (`KUBECONFIG`, `--server` / `--token`, etc.).
# Attach the `microshift-api` provider when the seat needs API egress + a
# sealed `KUBE_TOKEN` for Bearer rewrite on the provider's endpoints.
#
# Host-side seats typically reach the cluster through the Tailscale
# Kubernetes operator API proxy
# (`https://microshift-operator.<tailnet>.ts.net`). Ship the kube-apiserver
# CAs for any direct cluster TLS.
#
#   podman build -f sandbox/microshift/Containerfile -t quay.io/sandboard-app/sandbox-microshift:latest .

FROM quay.io/sandboard-app/sandbox-cursor:latest

USER root

ARG OCP_CLIENT_VERSION=stable-4.18

COPY sandbox/microshift/kube-apiserver-external-signer.crt \
     /etc/pki/ca-trust/source/anchors/kube-apiserver-external-signer.crt
COPY sandbox/microshift/kube-apiserver-service-network-signer.crt \
     /etc/pki/ca-trust/source/anchors/kube-apiserver-service-network-signer.crt

RUN update-ca-trust extract \
 && mkdir -p /etc/ssl/certs \
 && ln -sfn /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
      /etc/ssl/certs/ca-certificates.crt

RUN mkdir -p /opt/openshift \
 && curl -fsSL \
      "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OCP_CLIENT_VERSION}/openshift-client-linux.tar.gz" \
      | tar -xz -C /opt/openshift oc kubectl \
 && chmod 755 /opt/openshift/oc /opt/openshift/kubectl \
 && ln -sfn /opt/openshift/oc /usr/local/bin/oc \
 && ln -sfn /opt/openshift/kubectl /usr/local/bin/kubectl \
 && oc version --client \
 && kubectl version --client

USER sandbox
WORKDIR /sandbox
