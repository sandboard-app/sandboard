# sandboard agent sandbox = a minimal Red Hat UBI9 base + a Rust toolchain, split
# into one build target per agent engine. No sandboard source or dependency cache
# is baked in — cards fetch crates.io/npm live and build against their own
# checkout, same as any other repo sandboard might dispatch work against.
#
# Why our own base instead of the OpenShell community image: that image bakes
# in every supported agent CLI (Claude, OpenCode via a bug-bloated npm package
# with 4 redundant platform binaries, Copilot, Codex) plus a Python/uv/
# cloudpickle "skills" venv sandboard never touches, regardless of which
# engine-specific target you build — about 1.2GB of dead weight per image on
# top of another ~950MB of Ubuntu convenience tooling (vim, nano, traceroute,
# ping, openssh-sftp-server) this project doesn't use. OpenShell's own
# documented minimum for a custom sandbox image is just iproute2 (required,
# network namespace management) and nftables (optional, bypass detection) —
# see examples/bring-your-own-container/Dockerfile in the OpenShell source.
# Everything below that line is ours to choose. Bare `ubi9/ubi` plus exactly
# what sandboard needs measures ~760MB versus the old base's 3.42GB.
#
# Why one image per engine: each sandbox only carries the CLI it will
# actually run — no agy/opencode binaries sitting unused (and unaudited) in
# a Cursor sandbox. `shared` holds everything engine-independent so all five
# targets reuse the same cached layers; only the CLI install happens per
# leaf stage, so a broken/changed installer script never invalidates the
# shared layers below it.
#
# Why the toolchain is baked in but the dependency cache is not: reinstalling
# rustup (and its components) fresh on every card would cost real wall-clock
# and inference spend for zero benefit — nobody ever wants a different
# toolchain build per run. A sandboard source snapshot and its compiled dependency
# tree are the opposite: they go stale the moment a PR merges, so baking them
# into a multi-GB image just means rebuilding and re-pushing that image on
# every merge to keep pace. Cards build against crates.io/npm directly instead
# — see the network policy note at the bottom.
#
# `make sandbox` builds all five `quay.io/sandboard-app/sandbox-<engine>:latest`;
# `make sandbox-push` also pushes them. Or directly:
#   podman build -f sandbox/Containerfile --target cursor -t quay.io/sandboard-app/sandbox-cursor:latest .
#
# Then pair it with the worker board-profile policy companion entries — see the
# note at the bottom (and src/seed_policies.rs for the per-engine cockpit seed).

ARG UV_VERSION=0.11.29
FROM ghcr.io/astral-sh/uv:${UV_VERSION}-python3.13-trixie AS hermes-uv

FROM registry.access.redhat.com/ubi9/ubi:latest AS shared

USER root

# OpenShell policy looks up `process.run_as_user`/`run_as_group` by name
# ("sandbox"). OpenShift restricted SCC ignores image USER and assigns a
# random UID in supplementary group 0. Files owned by a baked-in uid (the
# Cursor installer tarball uses 2000) are unreadable to that UID; Landlock
# then *skips* the path at apply (`skipped:1`) and every later open is
# EACCES. Keep the named user for local rootless podman. Do not add that
# user to GID 0 (`-G root`): OpenShell's supervisor refuses
# "OCI user is a member of prohibited GID 0". OpenShift still gets group-0
# *file* ownership (`chown *:root` / `chgrp 0` + `g=u`) — SCC injects group
# 0 for the random UID; the passwd entry does not need it. Never preserve
# foreign uids from `cp -a`.
RUN groupadd -r supervisor \
 && useradd -r -g supervisor -s /usr/sbin/nologin supervisor \
 && groupadd -r sandbox \
 && useradd -r -g sandbox -d /sandbox -s /bin/bash sandbox \
 && mkdir -p /sandbox \
 && chown sandbox:root /sandbox \
 && chmod 0775 /sandbox \
 && chmod g+s /sandbox

# OS-level tools. `iproute` (network namespace management) and `nftables`
# (bypass detection) are OpenShell's own documented minimum for a custom
# sandbox image. `git`/`nodejs`/`npm`/`gh` are sandboard's own build and agent
# requirements — `curl`/`ca-certificates` ship on `ubi9/ubi` by default.
# `gcc`/`gcc-c++`/`make` exist so a card's own `cargo build` can compile: the
# `ring` crate (via rustls/tonic's `tls-ring` feature) and sqlx's `sqlite`
# feature both compile C/assembly. `procps-ng` and `socat` are agent runtime
# conveniences (`ps`, and the Cockpit MCP UDS relay — see below).
RUN dnf module enable nodejs:22 -y \
 && dnf install -y --setopt=install_weak_deps=False \
      git nodejs npm gcc gcc-c++ make \
      iproute nftables socat procps-ng dnf-plugins-core \
 && dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo \
 && dnf install -y --setopt=install_weak_deps=False gh \
 && dnf clean all

# Match the host toolchain. Cargo.toml declares rust-version = "1.88", so this
# only needs to be >= that; pinning keeps sandbox builds reproducible.
ARG RUST_VERSION=1.97.1

# Toolchain lives outside $HOME because /sandbox is the agent's writable
# workdir and gets overlaid at runtime — anything installed there would
# vanish. $CARGO_HOME / $CARGO_TARGET_DIR / $NPM_CONFIG_CACHE live under /opt
# too, so a card's own `cargo build` / `npm ci` populate them there instead of
# under /sandbox — the same reasoning, not a pre-warmed cache (there is none).
# HOME=/sandbox matches the sandbox user's passwd home. OpenShell's supervisor
# often starts as root (HOME=/root); agents that inherit that miss
# /sandbox/.cursor/mcp.json. sandboard also passes HOME explicitly in agent_env.
ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    CARGO_TARGET_DIR=/opt/cargo-target \
    NPM_CONFIG_CACHE=/opt/npm-cache \
    HOME=/sandbox \
    PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# `chmod` right here, in the same layer that creates these files — a later,
# separate `RUN chmod -R` would force a full copy-up of the whole toolchain
# into a new layer (permission bits differ, so overlayfs treats every file as
# changed), roughly doubling the image size for a metadata-only fix.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal \
           --default-toolchain "${RUST_VERSION}" \
           --component clippy \
 && cargo --version && clippy-driver --version \
 && chmod -R a+rX /opt/rust \
 && chgrp -R 0 /opt/rust \
 && chmod -R g=u /opt/rust

# $CARGO_HOME / $CARGO_TARGET_DIR / $NPM_CONFIG_CACHE start empty — a card's
# own `cargo build` / `npm ci` populate them at runtime as the unprivileged
# `sandbox` user, so they need to be writable from the start.
RUN mkdir -p /opt/cargo /opt/cargo-target /opt/npm-cache \
 && chmod -R a+rwX /opt/cargo /opt/cargo-target /opt/npm-cache \
 && chgrp -R 0 /opt/cargo /opt/cargo-target /opt/npm-cache \
 && chmod -R g=u /opt/cargo /opt/cargo-target /opt/npm-cache

# ---- rustup shims & environment --------------------------------------------

# The toolchain must work from ANY shell, not just one that inherited our env.
#
# `ENV` here does not reach `openshell sandbox exec`, and passing PATH via
# --env is not enough either: the agent runs its own tool calls in subshells
# that do not necessarily carry it. The observed failure was
# `timeout: failed to run command 'cargo': No such file or directory` (exit
# 127) — the agent simply could not see cargo, on a card whose whole job is to
# build this project.
#
# Wrapper scripts in /usr/local/bin (always on the default PATH) that set
# RUSTUP_HOME and CARGO_HOME themselves. Plain symlinks would not do: the
# binaries are rustup shims and fail with "could not choose a version of cargo
# to run" when RUSTUP_HOME is unset.
RUN for b in cargo rustc rustup clippy-driver cargo-clippy cargo-fmt rustfmt; do \
      printf '#!/bin/sh\nexport RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo CARGO_TARGET_DIR=/opt/cargo-target\nexec /opt/cargo/bin/%s "$@"\n' "$b" \
        > "/usr/local/bin/$b" && chmod 0755 "/usr/local/bin/$b"; \
    done \
 && printf 'export RUSTUP_HOME=/opt/rust\nexport CARGO_HOME=/opt/cargo\nexport CARGO_TARGET_DIR=/opt/cargo-target\nexport NPM_CONFIG_CACHE=/opt/npm-cache\nexport PATH=/opt/cargo/bin:$PATH\n' \
      > /etc/profile.d/rust.sh && chmod 0644 /etc/profile.d/rust.sh

# Cockpit MCP reaches the agent's stdio MCP client through `socat` (installed
# above) on a local Unix socket (cockpit_mcp_tunnel::AGENT_SOCK_PATH). Not
# `nc`: OpenBSD-netcat builds accept a UDS connection fine but never forward
# bytes written to their stdin *after* accept out to the socket — exactly the
# relay->client direction serve_server's responses need.

# ---- per-engine leaf stages -------------------------------------------------
# Each installs only its own CLI, after the shared layers above — a
# broken/changed installer script invalidates just that one target's image.

FROM shared AS cursor

# Bake Cursor Agent CLI. Installers honor $HOME; shared sets HOME=/sandbox for
# runtime, so force HOME=/root for this root-user build step. Then move under
# /opt so the sandbox user's /sandbox HOME overlay does not hide it, and put a
# stable /usr/local/bin/agent on the default PATH (exec env does not inherit
# image ENV).
# Install under HOME=/root, then move to /opt. Do NOT run `agent --version`
# (or anything that writes config) with the image ENV HOME=/sandbox while still
# root — that leaves /sandbox/.cursor root-owned and the sandbox user hits
# EACCES creating projects/ at runtime.
RUN HOME=/root curl -fsSL https://cursor.com/install | HOME=/root bash \
 && mkdir -p /opt/cursor-agent \
 && cp -a --no-preserve=ownership /root/.local/share/cursor-agent/. /opt/cursor-agent/ \
 && chown -R root:root /opt/cursor-agent \
 && AGENT_BIN="$(find /opt/cursor-agent/versions -type f -name cursor-agent | sort | tail -1)" \
 && test -n "$AGENT_BIN" \
 && ln -sfn "$AGENT_BIN" /usr/local/bin/agent \
 && ln -sfn "$AGENT_BIN" /usr/local/bin/cursor-agent \
 && chmod -R a+rX /opt/cursor-agent \
 && HOME=/tmp /usr/local/bin/agent --version \
 && rm -rf /sandbox/.cursor /sandbox/.cache \
 && mkdir -p /sandbox \
 && chown -R sandbox:root /sandbox \
 && chmod -R g=u /sandbox \
 && chmod g+s /sandbox

USER sandbox
WORKDIR /sandbox

FROM shared AS agy

# Bake Google Antigravity CLI (agy). HOME=/root — see cursor stage.
RUN HOME=/root curl -fsSL https://antigravity.google/cli/install.sh | HOME=/root bash \
 && cp /root/.local/bin/agy /usr/local/bin/agy \
 && chmod 0755 /usr/local/bin/agy

USER sandbox
WORKDIR /sandbox

FROM shared AS claude

# Bake Claude Code CLI. The old community base shipped this for free; our own
# minimal base does not, so every engine (including this one) installs only
# what it needs, same as the other three leaf stages. HOME=/root — see cursor.
RUN HOME=/root curl -fsSL https://claude.ai/install.sh | HOME=/root bash \
 && cp /root/.local/bin/claude /usr/local/bin/claude \
 && chmod 755 /usr/local/bin/claude

USER sandbox
WORKDIR /sandbox

FROM shared AS opencode

# Bake OpenCode CLI. Installer writes $HOME/.opencode/bin; relocate under /opt
# and expose /usr/local/bin/opencode on the default PATH (same ENV caveat).
# HOME=/root — see cursor stage.
RUN HOME=/root curl -fsSL https://opencode.ai/install | HOME=/root bash -s -- --no-modify-path \
 && mkdir -p /opt/opencode \
 && cp -a --no-preserve=ownership /root/.opencode/. /opt/opencode/ \
 && chown -R root:root /opt/opencode \
 && test -x /opt/opencode/bin/opencode \
 && ln -sfn /opt/opencode/bin/opencode /usr/local/bin/opencode \
 && chmod -R a+rX /opt/opencode \
 # The image ENV sets HOME=/sandbox, but this probe runs as root. Keep
 # OpenCode's first-run config out of the sandbox user's writable home.
 && HOME=/root /usr/local/bin/opencode --version \
 && test ! -e /sandbox/.config/opencode

USER sandbox
WORKDIR /sandbox

FROM shared AS hermes

# Hermes requires Python 3.11–3.13. Use the UBI9 Python 3.12 package and uv's
# own static binary only during the build; the runtime wrapper calls the venv
# directly, so uv is not part of the final image surface.
ARG HERMES_GIT_URL=https://github.com/NousResearch/hermes-agent.git
ARG HERMES_GIT_REF=7b5e1911f88be05eb5f9ce34453149dddd95ced3
COPY --from=hermes-uv /usr/local/bin/uv /usr/local/bin/uv
RUN dnf install -y --setopt=install_weak_deps=False python3.12 python3.12-pip \
 && mkdir -p /opt/hermes \
 && git -C /opt/hermes init \
 && git -C /opt/hermes remote add origin "${HERMES_GIT_URL}" \
 && git -C /opt/hermes fetch --depth 1 origin "${HERMES_GIT_REF}" \
 && git -C /opt/hermes checkout --detach FETCH_HEAD \
 && cd /opt/hermes \
 && UV_PYTHON_DOWNLOADS=never UV_CACHE_DIR=/tmp/uv-cache \
      /usr/local/bin/uv sync --frozen --no-dev --extra mcp \
        --python /usr/bin/python3.12 \
 && HOME=/tmp HERMES_HOME=/tmp/hermes-build-home /opt/hermes/.venv/bin/hermes --version \
 && rm -rf /tmp/hermes-build-home /sandbox/.hermes /opt/hermes/.git /tmp/uv-cache /root/.cache \
 && rm -f /usr/local/bin/uv \
 && chmod -R a+rX /opt/hermes \
 && chgrp -R 0 /opt/hermes \
 && chmod -R g=u /opt/hermes

COPY sandbox/hermes/config.yaml /usr/share/hermes/config.yaml
COPY sandbox/hermes/hermes /usr/local/bin/hermes
RUN chmod 0644 /usr/share/hermes/config.yaml \
 && chmod 0755 /usr/local/bin/hermes

# ---- pi ---------------------------------------------------------------
# Pi is a Node.js coding agent. Install the global binary and provide a
# wrapper that keeps state in /sandbox.
FROM shared AS pi

# Install pi globally. `--ignore-scripts` is safe — pi has no install scripts
# for normal npm installs (see upstream README).
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
 && /usr/local/bin/pi --version \
 && rm -rf /root/.npm /tmp/* /var/cache/dnf

COPY sandbox/pi/pi /usr/local/bin/pi
RUN chmod 0755 /usr/local/bin/pi

USER sandbox
WORKDIR /sandbox

# ---- board profile policy companion changes -------------------------------
# OpenShell matches binary paths LITERALLY and does not follow the toolchain's
# own symlinks, so each per-engine sandbox profile's policy needs, at minimum:
#
#   filesystem_policy.read_write:  /opt/cargo, /opt/cargo-target, /opt/npm-cache
#                                   (populated live — a card's own build, not
#                                   a pre-baked cache, so these must be
#                                   writable, not read-only)
#   filesystem_policy.read_only:   /opt/rust (+ that engine's own /opt/<engine> path)
#
# and a network policy allowing index.crates.io / static.crates.io /
# registry.npmjs.org / github.com (the git dependency in Cargo.toml) for
# /opt/cargo/bin/cargo, /usr/bin/npm, and /usr/bin/node. There is no warm
# cache to fall back on, so denying this egress means every card's first
# `cargo build`/`npm ci` simply fails.
# src/seed_policies.rs seeds one minimal cockpit policy per engine
# (cockpit-cursor, cockpit-agy, cockpit-claude, cockpit-opencode, cockpit-hermes,
# cockpit-pi) matching
# each split image's contents; edit the live Policy under Settings →
# OpenShell → Policies if the catalog already exists.
