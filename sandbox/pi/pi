#!/bin/sh
set -eu

# Keep pi state in the sandbox rather than in the image or the host.
export PI_AGENT_DIR="${PI_AGENT_DIR:-/sandbox/.pi/agent}"
export HOME="${HOME:-/sandbox}"
unset CUSTOM_BASE_URL OPENAI_BASE_URL OPENROUTER_BASE_URL ANTHROPIC_BASE_URL
export NODE_OPTIONS="--no-warnings"

mkdir -p "$PI_AGENT_DIR"

exec /usr/local/bin/pi "$@"
